{
  "name": "SyzygyBase",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "ios": "npm install && bundle install && cd ios && pod install && cd .. && npx react-native run-ios",
    "android": "npm install && npx react-native run-android",
    "clean": "rm -rf node_modules && rm -rf ios/Pods && rm -rf ios/Podfile.lock && rm -rf /tmp/metro-* && rm -rf android/.gradle",
    "start": "npx react-native start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && node scripts/fix-simulator.js"
  },
  "dependencies": {
    "@react-native/new-app-screen": "^0.84.1",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/stack": "^7.10.17",
    "axios": "^1.18.1",
    "react": "19.2.3",
    "react-native": "^0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keychain": "^9.2.3",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.28.0",
    "syzygy-ai-rn": "^3.0.0",
    "syzygy-core-rn": "^3.0.0",
    "syzygy-foundation-rn": "^3.0.0",
    "syzygy-services-rn": "^3.0.0",
    "syzygy-ui-rn": "^3.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^13.5.1",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "^15.0.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
